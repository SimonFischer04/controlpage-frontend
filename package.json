{
  "name": "controlpage-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:open": "ng run controlpage-frontend:cypress-open",
    "e2e:env:up": "docker compose -f docker-compose.e2e.yml up --wait -d",
    "e2e:env:pull": "docker compose -f docker-compose.e2e.yml pull",
    "e2e:env:down": "docker compose -f docker-compose.e2e.yml down -v",
    "gen": "openapi --input http://localhost:42000/v3/api-docs --output src/gen --client angular --useOptions",
    "gen:file": "openapi --input openapi.json --output src/gen --client angular --useOptions"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "deep-equal": "^2.2.2",
    "ngx-mat-select-search": "^8.0.6",
    "rxjs": "^7.5.4",
    "screenfull": "^6.0.2",
    "tslib": "^2.3.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.30",
    "@angular-devkit/core": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/language-service": "^21.2.26",
    "@cypress/schematic": "^2.5.2",
    "@eslint/js": "^10.0.1",
    "@types/deep-equal": "^1.0.1",
    "@types/node": "^18.17.5",
    "angular-eslint": "^21.4.0",
    "cypress": "^13.17.0",
    "cypress-multi-reporters": "^2.1.0",
    "eslint": "^10.15.0",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2.2.1",
    "openapi-typescript-codegen": "^0.25.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
