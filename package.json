{
  "name": "controlpage-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:open": "ng run controlpage-frontend:cypress-open",
    "e2e:env:up": "docker compose -f docker-compose.e2e.yml up --wait -d",
    "e2e:env:pull": "docker compose -f docker-compose.e2e.yml pull",
    "e2e:env:down": "docker compose -f docker-compose.e2e.yml down -v",
    "gen": "openapi --input http://localhost:42000/v3/api-docs --output src/gen --client angular --useOptions",
    "gen:file": "openapi --input openapi.json --output src/gen --client angular --useOptions"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "deep-equal": "^2.2.2",
    "ngx-mat-select-search": "^9.0.0",
    "rxjs": "^7.5.4",
    "screenfull": "^6.0.2",
    "tslib": "^2.3.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.7",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@cypress/schematic": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@types/deep-equal": "^1.0.1",
    "@types/node": "^22.20.5",
    "angular-eslint": "^22.7.0",
    "cypress": "^16.3.0",
    "cypress-multi-reporters": "^2.1.0",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "mocha-junit-reporter": "^2.2.1",
    "openapi-typescript-codegen": "^0.25.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
